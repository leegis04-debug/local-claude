#!/usr/bin/env bash
# gjw — 사업계획서 P축 진입점 (proposal 트랙). 기존 ~/.local/bin/jw 와 병존.
# 점진 전환용. 완전 치환 준비되면 `alias jw=gjw` 로.
set -eu
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_root="$(cd "$_dir/.." && pwd)"
# shellcheck source=./_lc_common.sh
. "$_dir/_lc_common.sh"
export PYTHONPATH="$_root/src${PYTHONPATH:+:$PYTHONPATH}"
PY="$(_lc_pick_python "$_root")"

stage=""
project=""
mode=""
coherence=""
model=""
form=""
panel=""          # "on" | "off" | ""(기본, env 따름)
args=()
while (( $# > 0 )); do
  case "$1" in
    --project|-P)  project="$2"; shift 2 ;;
    --project=*)   project="${1#--project=}"; shift ;;
    --mode)        mode="$2"; shift 2 ;;
    --mode=*)      mode="${1#--mode=}"; shift ;;
    --coherence)   coherence="$2"; shift 2 ;;
    --coherence=*) coherence="${1#--coherence=}"; shift ;;
    --model)       model="$2"; shift 2 ;;
    --model=*)     model="${1#--model=}"; shift ;;
    --form)        form="$2"; shift 2 ;;
    --form=*)      form="${1#--form=}"; shift ;;
    --panel)       panel="on"; shift ;;
    --no-panel)    panel="off"; shift ;;
    --help|-h)
      cat >&2 <<'USAGE'
gjw — proposal 트랙 (idea|debate|structure|spec|risk-check|experiment-plan|proposal|final-doc)
사용: gjw <stage> "<input>" [--project <dir>] [--mode classic|sv|svr|svrr]
                           [--coherence strict|loose|off] [--model <ollama>]
                           [--form <form-id>] [--panel | --no-panel]

  --panel      stage 별 4~5 persona 패널 활성 (analyst/strategist/architect/critic/writer)
               GP_PERSONAS=on 효과. svrr 모드에서는 persona 드래프트 → Verifier L1
               필터 → integrator 가 합성. 섹션당 호출 수 3~5배 증가.
  --no-panel   GP_PERSONAS=off 강제 (기본)
USAGE
      exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done

# --panel / --no-panel → GP_PERSONAS env 로 명확히 주입
if [ "$panel" = "on" ]; then
  export GP_PERSONAS=on
elif [ "$panel" = "off" ]; then
  export GP_PERSONAS=off
fi

stage="${args[0]:-}"
[ -z "$stage" ] && { echo "사용: gjw <stage> ..." >&2; exit 1; }
input="${args[*]:1}"
project="${project:-${JW_PROJECT_DIR:-$PWD}}"

cmd=("$PY" -m gstar.cli.main project run proposal "$stage" --project "$project")
[ -n "$input" ]     && cmd+=(--input "$input")
[ -n "$mode" ]      && cmd+=(--mode "$mode")
[ -n "$coherence" ] && cmd+=(--coherence "$coherence")
[ -n "$model" ]     && cmd+=(--model "$model")
[ -n "$form" ]      && cmd+=(--form "$form")
exec "${cmd[@]}"
