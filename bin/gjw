#!/usr/bin/env bash
# gjw — 사업계획서 P축 진입점 (proposal 트랙). 기존 ~/.local/bin/jw 와 병존.
# 점진 전환용. 완전 치환 준비되면 `alias jw=gjw` 로.
set -eu
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_root="$(cd "$_dir/.." && pwd)"
# shellcheck source=./_lc_common.sh
. "$_dir/_lc_common.sh"
export PYTHONPATH="$_root/src${PYTHONPATH:+:$PYTHONPATH}"
PY="$(_lc_pick_python "$_root")"

stage=""
project=""
mode=""
coherence=""
model=""
form=""
panel=""          # "on" | "off" | ""(기본, env 따름)
args=()
while (( $# > 0 )); do
  case "$1" in
    --project|-P)  project="$2"; shift 2 ;;
    --project=*)   project="${1#--project=}"; shift ;;
    --mode)        mode="$2"; shift 2 ;;
    --mode=*)      mode="${1#--mode=}"; shift ;;
    --coherence)   coherence="$2"; shift 2 ;;
    --coherence=*) coherence="${1#--coherence=}"; shift ;;
    --model)       model="$2"; shift 2 ;;
    --model=*)     model="${1#--model=}"; shift ;;
    --form)        form="$2"; shift 2 ;;
    --form=*)      form="${1#--form=}"; shift ;;
    --panel)       panel="on"; shift ;;
    --no-panel)    panel="off"; shift ;;
    --limit)       limit="$2"; shift 2 ;;
    --limit=*)     limit="${1#--limit=}"; shift ;;
    --no-form)     no_form="on"; shift ;;
    --rank)        rank="on"; shift ;;
    --no-rank)     rank="off"; shift ;;
    --rank-rag)    rank="on"; rank_rag="on"; shift ;;
    --jira)        jira_key="$2"; shift 2 ;;
    --jira=*)      jira_key="${1#--jira=}"; shift ;;
    --from-ri)     from_ri="$2"; shift 2 ;;
    --from-ri=*)   from_ri="${1#--from-ri=}"; shift ;;
    --help|-h)
      cat >&2 <<'USAGE'
gjw — proposal 트랙 (idea|debate|structure|spec|risk-check|experiment-plan|proposal|final-doc)
사용: gjw <stage> "<input>" [--project <dir>] [--mode classic|sv|svr|svrr]
                           [--coherence strict|loose|off] [--model <ollama>]
                           [--form <form-id>] [--panel | --no-panel]
                           [--limit N] [--no-form]
                           [--rank | --no-rank | --rank-rag]

  --panel      stage 별 4~5 persona 패널. svrr 에서 draft→L1→integrator.
  --no-panel   GP_PERSONAS=off 강제
  --limit N    per-question 처음 N개만 (timeout 회피)
  --no-form    양식 무시, legacy 단일 섹션
  --rank       질문 중요도 heuristic 랭킹 후 상위 N 선택 (기본 on)
  --no-rank    원문 순서 유지
  --rank-rag   heuristic + G /search/fused 관련성까지 고려 (정확도↑, 속도↓)

예시:
  gjw idea "토픽" --mode svrr                        # 전부 (수십분)
  gjw idea "토픽" --mode svrr --limit 5              # 중요도 top 5
  gjw idea "토픽" --mode svrr --limit 5 --no-rank    # 원문 앞 5개
  gjw idea "토픽" --mode svrr --rank-rag --limit 10  # G 근거 가진 top 10
  gjw idea "토픽" --mode svrr --panel --limit 3      # 패널+top 3
  gjw idea "토픽" --mode svrr --no-form              # 양식 무시
USAGE
      exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done

# --panel / --no-panel → GP_PERSONAS env 주입
if [ "$panel" = "on" ]; then
  export GP_PERSONAS=on
elif [ "$panel" = "off" ]; then
  export GP_PERSONAS=off
fi

# --limit N → GP_QUESTION_LIMIT
if [ -n "${limit:-}" ]; then
  export GP_QUESTION_LIMIT="$limit"
fi

# --no-form → GP_FORM_QUESTIONS=off
if [ "${no_form:-}" = "on" ]; then
  export GP_FORM_QUESTIONS=off
fi

# --rank / --no-rank / --rank-rag
if [ "${rank:-}" = "on" ]; then
  export GP_QUESTION_RANK=on
elif [ "${rank:-}" = "off" ]; then
  export GP_QUESTION_RANK=off
fi
if [ "${rank_rag:-}" = "on" ]; then
  export GP_QUESTION_RANK_RAG=on
fi
if [ -n "${jira_key:-}" ]; then export GP_JIRA_KEY="$jira_key"; fi
if [ -n "${from_ri:-}" ]; then export GP_FROM_RI="$from_ri"; fi

stage="${args[0]:-}"
[ -z "$stage" ] && { echo "사용: gjw <stage> ..." >&2; exit 1; }
input="${args[*]:1}"
project="${project:-${JW_PROJECT_DIR:-$PWD}}"

cmd=("$PY" -m gstar.cli.main project run proposal "$stage" --project "$project")
[ -n "$input" ]     && cmd+=(--input "$input")
[ -n "$mode" ]      && cmd+=(--mode "$mode")
[ -n "$coherence" ] && cmd+=(--coherence "$coherence")
[ -n "$model" ]     && cmd+=(--model "$model")
[ -n "$form" ]      && cmd+=(--form "$form")
exec "${cmd[@]}"
