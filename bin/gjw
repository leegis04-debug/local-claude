#!/usr/bin/env bash
# gjw — 사업계획서 P축 진입점 (proposal 트랙). 기존 ~/.local/bin/jw 와 병존.
# 점진 전환용. 완전 치환 준비되면 `alias jw=gjw` 로.
set -eu
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_root="$(cd "$_dir/.." && pwd)"
# shellcheck source=./_lc_common.sh
. "$_dir/_lc_common.sh"
export PYTHONPATH="$_root/src${PYTHONPATH:+:$PYTHONPATH}"
PY="$(_lc_pick_python "$_root")"

stage=""
project=""
args=()
while (( $# > 0 )); do
  case "$1" in
    --project|-P) project="$2"; shift 2 ;;
    --project=*)  project="${1#--project=}"; shift ;;
    --help|-h)
      echo "gjw — proposal 트랙 (idea|debate|structure|spec|risk-check|experiment-plan|proposal|final-doc)" >&2
      echo "사용: gjw <stage> \"<input>\" [--project <dir>]" >&2
      exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done

stage="${args[0]:-}"
[ -z "$stage" ] && { echo "사용: gjw <stage> ..."; exit 1; }
input="${args[*]:1}"
project="${project:-${JW_PROJECT_DIR:-$PWD}}"

cmd=("$PY" -m gstar.cli.main project run proposal "$stage" --project "$project")
[ -n "$input" ] && cmd+=(--input "$input")
exec "${cmd[@]}"
