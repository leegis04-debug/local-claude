#!/usr/bin/env bash
# headless Chromium 으로 JS-렌더링 share 페이지 가져오기.
# 사용: fetch-share <URL> [--format markdown|json|text|html] [--timeout ms] [--wait 'selector']
set -eu
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_root="$(cd "$_dir/.." && pwd)"
# shellcheck source=./_lc_common.sh
. "$_dir/_lc_common.sh"
export PYTHONPATH="$_root/src${PYTHONPATH:+:$PYTHONPATH}"
PY="$(_lc_pick_python "$_root")"
exec "$PY" -m local_claude.tools.share_fetcher "$@"
