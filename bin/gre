#!/usr/bin/env bash
# gre — 연구개발 P축 진입점 (research 트랙). 기존 ~/.local/bin/re 와 병존.
set -eu
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_root="$(cd "$_dir/.." && pwd)"
# shellcheck source=./_lc_common.sh
. "$_dir/_lc_common.sh"
export PYTHONPATH="$_root/src${PYTHONPATH:+:$PYTHONPATH}"
PY="$(_lc_pick_python "$_root")"

stage=""
project=""
mode=""
coherence=""
model=""
form=""
panel=""
args=()
while (( $# > 0 )); do
  case "$1" in
    --project|-P)  project="$2"; shift 2 ;;
    --project=*)   project="${1#--project=}"; shift ;;
    --mode)        mode="$2"; shift 2 ;;
    --mode=*)      mode="${1#--mode=}"; shift ;;
    --coherence)   coherence="$2"; shift 2 ;;
    --coherence=*) coherence="${1#--coherence=}"; shift ;;
    --model)       model="$2"; shift 2 ;;
    --model=*)     model="${1#--model=}"; shift ;;
    --form)        form="$2"; shift 2 ;;
    --form=*)      form="${1#--form=}"; shift ;;
    --panel)       panel="on"; shift ;;
    --no-panel)    panel="off"; shift ;;
    --limit)       limit="$2"; shift 2 ;;
    --limit=*)     limit="${1#--limit=}"; shift ;;
    --no-form)     no_form="on"; shift ;;
    --rank)        rank="on"; shift ;;
    --no-rank)     rank="off"; shift ;;
    --rank-rag)    rank="on"; rank_rag="on"; shift ;;
    --jira)        jira_key="$2"; shift 2 ;;
    --jira=*)      jira_key="${1#--jira=}"; shift ;;
    --from-ri)     from_ri="$2"; shift 2 ;;
    --from-ri=*)   from_ri="${1#--from-ri=}"; shift ;;
    --help|-h)
      cat >&2 <<'USAGE'
gre — research 트랙 (idea|structure|spec|experiment-plan|proposal|final-doc|lab-note|...)
사용: gre <stage> "<input>" [--project <dir>] [--mode classic|sv|svr|svrr]
                           [--coherence strict|loose|off] [--model <ollama>]
                           [--form <form-id>] [--panel | --no-panel]
                           [--limit N] [--no-form]
                           [--rank | --no-rank | --rank-rag]

  --panel      persona 패널 활성
  --limit N    per-question 처음 N개만
  --no-form    양식 무시
  --rank       중요도 랭킹 (기본 on)
  --rank-rag   rank + G /search 관련성 반영
USAGE
      exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done

if [ "$panel" = "on" ]; then
  export GP_PERSONAS=on
elif [ "$panel" = "off" ]; then
  export GP_PERSONAS=off
fi
if [ -n "${limit:-}" ]; then export GP_QUESTION_LIMIT="$limit"; fi
if [ "${no_form:-}" = "on" ]; then export GP_FORM_QUESTIONS=off; fi
if [ "${rank:-}" = "on" ]; then export GP_QUESTION_RANK=on
elif [ "${rank:-}" = "off" ]; then export GP_QUESTION_RANK=off; fi
if [ "${rank_rag:-}" = "on" ]; then export GP_QUESTION_RANK_RAG=on; fi
if [ -n "${jira_key:-}" ]; then export GP_JIRA_KEY="$jira_key"; fi
if [ -n "${from_ri:-}" ]; then export GP_FROM_RI="$from_ri"; fi

stage="${args[0]:-}"
[ -z "$stage" ] && { echo "사용: gre <stage> ..." >&2; exit 1; }
input="${args[*]:1}"
project="${project:-${RE_PROJECT_DIR:-$PWD}}"

cmd=("$PY" -m gstar.cli.main project run research "$stage" --project "$project")
[ -n "$input" ]     && cmd+=(--input "$input")
[ -n "$mode" ]      && cmd+=(--mode "$mode")
[ -n "$coherence" ] && cmd+=(--coherence "$coherence")
[ -n "$model" ]     && cmd+=(--model "$model")
[ -n "$form" ]      && cmd+=(--form "$form")
exec "${cmd[@]}"
