#!/usr/bin/env bash
# gcode — 코딩 트랙 P축 진입점. `g project run coding <stage>` 의 얇은 shim.
# 사용: gcode <stage> "<input>" [--project <dir>]
set -eu
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_root="$(cd "$_dir/.." && pwd)"
# shellcheck source=./_lc_common.sh
. "$_dir/_lc_common.sh"
export PYTHONPATH="$_root/src${PYTHONPATH:+:$PYTHONPATH}"
PY="$(_lc_pick_python "$_root")"

stage=""
project=""
input=""
mode=""
coherence=""
model=""
form=""
panel=""
args=()
while (( $# > 0 )); do
  case "$1" in
    --project|-P)  project="$2"; shift 2 ;;
    --project=*)   project="${1#--project=}"; shift ;;
    --mode)        mode="$2"; shift 2 ;;
    --mode=*)      mode="${1#--mode=}"; shift ;;
    --coherence)   coherence="$2"; shift 2 ;;
    --coherence=*) coherence="${1#--coherence=}"; shift ;;
    --model)       model="$2"; shift 2 ;;
    --model=*)     model="${1#--model=}"; shift ;;
    --form)        form="$2"; shift 2 ;;
    --form=*)      form="${1#--form=}"; shift ;;
    --panel)       panel="on"; shift ;;
    --no-panel)    panel="off"; shift ;;
    --limit)       limit="$2"; shift 2 ;;
    --limit=*)     limit="${1#--limit=}"; shift ;;
    --no-form)     no_form="on"; shift ;;
    --rank)        rank="on"; shift ;;
    --no-rank)     rank="off"; shift ;;
    --rank-rag)    rank="on"; rank_rag="on"; shift ;;
    --help|-h)
      cat >&2 <<'USAGE'
gcode — 코딩 트랙 (explore|plan|implement|test|review)
사용: gcode <stage> "<input>" [--project <dir>] [--mode classic|sv|svr|svrr]
                              [--coherence strict|loose|off] [--model <ollama>]
                              [--panel | --no-panel] [--limit N] [--no-form]
                              [--rank | --no-rank | --rank-rag]
USAGE
      exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done

if [ "$panel" = "on" ]; then
  export GP_PERSONAS=on
elif [ "$panel" = "off" ]; then
  export GP_PERSONAS=off
fi
if [ -n "${limit:-}" ]; then export GP_QUESTION_LIMIT="$limit"; fi
if [ "${no_form:-}" = "on" ]; then export GP_FORM_QUESTIONS=off; fi
if [ "${rank:-}" = "on" ]; then export GP_QUESTION_RANK=on
elif [ "${rank:-}" = "off" ]; then export GP_QUESTION_RANK=off; fi
if [ "${rank_rag:-}" = "on" ]; then export GP_QUESTION_RANK_RAG=on; fi

stage="${args[0]:-}"
[ -z "$stage" ] && { echo "사용: gcode <stage> ..." >&2; exit 1; }
input="${args[*]:1}"
project="${project:-$PWD}"

cmd=("$PY" -m gstar.cli.main project run coding "$stage" --project "$project")
[ -n "$input" ]     && cmd+=(--input "$input")
[ -n "$mode" ]      && cmd+=(--mode "$mode")
[ -n "$coherence" ] && cmd+=(--coherence "$coherence")
[ -n "$model" ]     && cmd+=(--model "$model")
[ -n "$form" ]      && cmd+=(--form "$form")
exec "${cmd[@]}"
