<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent 템플릿 — ~/Library/LaunchAgents/ 에 복사 후 load.
     맥북이 home context 일 때 1시간 주기로 g-serve 에서 mirror pull.
     설치:
       cp bin/g-mirror-sync.plist ~/Library/LaunchAgents/com.local-claude.g-mirror.plist
       launchctl load ~/Library/LaunchAgents/com.local-claude.g-mirror.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local-claude.g-mirror</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/workspace/local-claude" &amp;&amp; ./bin/ctx current | grep -q '^home$' &amp;&amp; rsync -av --delete ljw-op:/volume1/docker/gstar-data/state/ "$HOME/.gstar-mirror/"</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/tmp/g-mirror.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/g-mirror.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
