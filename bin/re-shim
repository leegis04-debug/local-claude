#!/usr/bin/env bash
# re-shim — re wrapper 용. jw-shim 과 동일 패턴.
set -eu
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_root="$(cd "$_dir/.." && pwd)"
export PYTHONPATH="$_root/src${PYTHONPATH:+:$PYTHONPATH}"
PY="${LC_PYTHON:-python3}"
if [ -x "$_root/.venv/bin/python3" ]; then PY="$_root/.venv/bin/python3"; fi

BACKEND="$("$PY" -m ctx.cli get re.rag_backend 2>/dev/null || echo "gateway")"
G_URL="$("$PY" -m ctx.cli get gstar.server_url 2>/dev/null || echo "http://100.79.251.53:9999")"
GW_URL="$("$PY" -m ctx.cli get network.gateway_url 2>/dev/null || echo "http://100.79.251.53:8000")"

case "$BACKEND" in
  g)     export GATEWAY_URL="$G_URL"  LC_GATEWAY_URL="$G_URL"  RE_RAG_BACKEND=g ;;
  both)  export GATEWAY_URL="$G_URL"  LC_GATEWAY_URL="$G_URL"  RE_RAG_BACKEND=both ;;
  *)     export GATEWAY_URL="$GW_URL" LC_GATEWAY_URL="$GW_URL" RE_RAG_BACKEND=gateway ;;
esac

# Phase C1 — G worker pause/resume hook. GP_AUTOPAUSE=off 로 비활성화 가능.
if [ "${GP_AUTOPAUSE:-on}" != "off" ]; then
  _GP_PAUSE_URL="${G_URL}/worker/pause"
  _GP_RESUME_URL="${G_URL}/worker/resume"
  curl -sf -m 2 -X POST "$_GP_PAUSE_URL" >/dev/null 2>&1 || true
  trap 'curl -sf -m 2 -X POST "$_GP_RESUME_URL" >/dev/null 2>&1 || true' EXIT
fi

ORIG_PATH="${PATH//"$_dir":/}"
ORIG_PATH="${ORIG_PATH//:"$_dir"/}"
ORIG="$(PATH="$ORIG_PATH" command -v re 2>/dev/null || true)"
[ -z "$ORIG" ] && [ -x "$HOME/.local/bin/re" ] && ORIG="$HOME/.local/bin/re"
if [ -z "$ORIG" ]; then
  echo "re-shim: 원본 re 를 찾을 수 없음" >&2
  exit 127
fi
# exec 대신 fork 로 실행해야 trap EXIT 의 resume 이 동작한다 (exec 는 쉘을 교체하므로 trap 증발).
"$ORIG" "$@"
