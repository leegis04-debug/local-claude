# 개발 환경변수 — 컨테이너 간 공유. .gitignore 권장.

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# Spring AI / Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# AI Worker
# - Docker 컨테이너로 실행 시: http://ai-worker:8001
# - 호스트 venv 직접 실행 시 (M2 MPS 활용): http://host.docker.internal:8001
AI_WORKER_URL=http://ai-worker:8001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

