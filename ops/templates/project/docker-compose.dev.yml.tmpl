# 마스터 docker-compose — init-dev 가 STACK 따라 마커 활성화/제거
# 형식 주의: __INCLUDE_*__ 라인은 # 주석으로 시작 → init-dev sed 로 활성화.
# __SERVICE_*__ 블록은 STACK 미포함 시 init-dev sed 로 통째 제거.

include:
  # __INCLUDE_PG__   - LOCAL_CLAUDE_PATH/ops/common/compose/postgres-pgvector.yml
  # __INCLUDE_REDIS__   - LOCAL_CLAUDE_PATH/ops/common/compose/redis.yml
  # __INCLUDE_MQTT__   - LOCAL_CLAUDE_PATH/ops/common/compose/mqtt.yml
  # __INCLUDE_OLLAMA__   - LOCAL_CLAUDE_PATH/ops/common/compose/ollama.yml
  # __INCLUDE_FE__   - LOCAL_CLAUDE_PATH/ops/common/compose/frontend.yml

services:
  # __SERVICE_BACKEND_BEGIN__
  spring-backend:
    build:
      context: ./spring-backend
      dockerfile: Dockerfile
    ports:
      - "8080:8080"
    environment:
      SPRING_PROFILES_ACTIVE: docker
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/${POSTGRES_DB:-app}
      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER:-dev}
      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD:-dev}
      AI_WORKER_URL: http://ai-worker:8001
      OLLAMA_BASE_URL: ${OLLAMA_BASE_URL:-http://ollama:11434}
      REDIS_HOST: redis
    depends_on:
      postgres:
        condition: service_healthy
  # __SERVICE_BACKEND_END__

  # __SERVICE_AI_WORKER_BEGIN__
  ai-worker:
    build:
      context: ./ai-worker
      dockerfile: Dockerfile
      args:
        BASE_IMAGE: local-claude/ops-ml:latest
    ports:
      - "8001:8001"
    volumes:
      - ./ai-worker/src:/workspace/src
      - ./ai-worker/models:/workspace/models
      - ../00-input/BASE:/workspace/ref:ro
    environment:
      ENV: development
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
  # __SERVICE_AI_WORKER_END__
