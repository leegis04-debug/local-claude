# 운영 환경변수 템플릿 — .env.prod 로 복사 후 실제 값 채우기.
# .env.prod 는 .gitignore 에 등록 (커밋 금지).
#
# 운영급은 Vault/AWS Secrets Manager 등 외부 시크릿 매니저 사용 권장.
# 단순 배포 시 이 파일을 4090 서버에 rsync 로 직접 전달 (chmod 600).

# PostgreSQL — 강한 비밀번호로 교체
POSTGRES_DB=app
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=__STRONG_RANDOM_PASSWORD__

# Spring AI / LLM
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# AI Worker
AI_WORKER_URL=http://ai-worker:8001

# Frontend (외부 노출 도메인)
NEXT_PUBLIC_API_URL=https://api.example.com

# Grafana 운영 비밀번호
GRAFANA_USER=admin
GRAFANA_PASSWORD=__STRONG_RANDOM_PASSWORD__

# MLflow Tracking
MLFLOW_TRACKING_URI=http://mlflow:5000

# Vault (옵션 — STACK=vault 시)
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=__ROOT_TOKEN_OR_APPROLE__
